<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE urlrewrite PUBLIC "-//tuckey.org//DTD UrlRewrite 4.0//EN"
"http://www.tuckey.org/res/dtds/urlrewrite4.0.dtd">

<!-- JBrowse entry points must revalidate so a release bump reaches clients;
     its hashed static/ bundles keep whatever /WEB-INF/urlrewrite.xml sets. -->
<urlrewrite>

  <rule>
    <name>JBrowse entry points</name>
    <from>^/jbrowse2/(index\.html|config\.json)?$</from>
    <set type="response-header" name="Cache-Control">no-cache</set>
    <to>-</to>
  </rule>

  <!-- The default config is the project root plus the artifact's plugins.
       The service reads the installed config.json from disk, so no loop. -->
  <rule>
    <name>JBrowse default config</name>
    <from>^/jbrowse2/config\.json$</from>
    <to type="forward" last="true">/service/jbrowse/jbrowse2/config.json</to>
  </rule>

</urlrewrite>
